PORT=3000
HOST=127.0.0.1
DATABASE_PATH=./data/festival.sqlite
# Required in production: exact public origin, no trailing slash
APP_ORIGIN=http://localhost:3000
NODE_ENV=development
STORY_ADMIN_TOKEN=
# Optional. Set these only when running the Temporal Service and Worker locally.
TEMPORAL_GATEWAY_URL=
TEMPORAL_GATEWAY_TOKEN=
TEMPORAL_ADDRESS=127.0.0.1:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=festival-room-sessions

# Google OAuth web client. Register APP_ORIGIN/api/platform/auth/google/callback as a redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Development only: explicit simulated Google sign-in. Always disabled in production.
GOOGLE_AUTH_DEMO=false

# Optional analytics; loaded only after explicit user consent.
PUBLIC_GTM_CONTAINER_ID=GTM-56Q5K95G

# Public SEO origin. QA builds must set PUBLIC_INDEXABLE=false.
PUBLIC_SITE_URL=https://eniveil.com
PUBLIC_INDEXABLE=true
