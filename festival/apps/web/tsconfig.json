{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "astro/client"
    ],
    "allowJs": true,
    "checkJs": true
  },
  "include": [
    ".astro/types.d.ts",
    "src/**/*",
    "../../packages/shared/src/**/*.ts"
  ],
  "exclude": [
    "dist"
  ]
}
