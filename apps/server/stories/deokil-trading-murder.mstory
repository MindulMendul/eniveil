    "scenes": [
      {
        "id": "opening",
        "cues": [
          { "type": "dialogue.show", "speaker": "내레이션", "text": "덕일상사 빌딩, 새벽 0시 10분." },
          { "type": "dialogue.show", "speaker": "내레이션", "text": "순찰 중이던 경비가 탕비실 불을 끄러 갔다가 쓰러진 사람을 발견했다." },
          { "type": "dialogue.show", "speaker": "내레이션", "text": "피해자는 박대리. 입엔 거품, 오른손엔 젓가락, 다리엔 뜨거운 물에 데인 자국. 사망 추정 시각은 오후 11시." },
          { "type": "dialogue.show", "speaker": "내레이션", "text": "인망 좋던 사원의 죽음. 용의자는 네 명. 탐정, 당신의 차례다." },
          { "type": "transition.play", "effect": "fade", "durationMs": 700 }
        ],
        "nextSceneId": "investigation"
      },
      { "id": "investigation", "cues": [], "nextSceneId": "resolution" },
      {
        "id": "resolution",
        "cues": [
          { "type": "dialogue.show", "speaker": "내레이션", "text": "탐정은 최사원 앞에 증거를 하나씩 늘어놓았다." },
          { "type": "dialogue.show", "speaker": "최사원", "text": "9시에 퇴근했어요. 맞아요. 하지만 그 전에… 그 사람의 컵라면에 손을 댔어요." },
          { "type": "dialogue.show", "speaker": "내레이션", "text": "오부장의 딸, 그리고 박대리의 거짓말. 배신감이 그녀를 무너뜨렸다." },
          { "type": "dialogue.show", "speaker": "최사원", "text": "말리고 싶어서 보냈다가 지웠어요. 먹지 않기를 바라면서도… 먹길 바랐어요." },
          { "type": "dialogue.show", "speaker": "내레이션", "text": "새벽, 덕일상사 앞. 최사원은 경찰차에 올랐다. 사건 종결." }
        ]
      }
    ],
    "roles": [],
    "information": [],
    "items": [],
