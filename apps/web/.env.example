# Optional public GTM container ID (GTM-XXXXXXX), loaded only after consent.
# This value is embedded in the static client bundle during the Astro build.
PUBLIC_GTM_CONTAINER_ID=

# Build-time origin for canonical links, sitemap and share metadata.
PUBLIC_SITE_URL=https://eniveil.com
# QA must use false to prevent indexing; production uses true.
PUBLIC_INDEXABLE=true
