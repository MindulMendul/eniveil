---
import "../shared/styles/base.css";
import Metadata from '../shared/seo/Metadata.astro';
const { locale = 'ko' } = Astro.props;
const en = locale === 'en';
const prefix = en ? '/en' : '';
---
<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <Metadata />
  </head>
  <body>
    <a class="skip-link" href="#main-content">{locale === "en" ? "Skip to content" : "본문으로 건너뛰기"}</a>
    <header class="px-5 py-5">
      <a href={`${prefix}/`}>{en ? 'Story Archive' : '스토리 아카이브'}</a>
      <nav aria-label={en ? 'Language' : '언어'}>
        <a href="/about/" lang="ko" hreflang="ko">한국어</a>
        <a href="/en/about/" lang="en" hreflang="en">English</a>
      </nav>
    </header>
    <main id="main-content" tabindex="-1" class="px-5 py-8">
      <h1>{en ? 'About Story Archive' : '스토리 아카이브 소개'}</h1>
      <p>{en ? 'Story Archive is a platform for interactive mystery stories. Discover stories, investigate alone or play assigned roles with friends.' : '스토리 아카이브는 인터랙티브 추리 작품을 탐색하고 플레이하는 플랫폼입니다. 혼자 사건을 조사하거나 친구들과 각자의 역할로 이야기에 참여할 수 있습니다.'}</p>
      <h2>{en ? 'Discover stories' : '작품 찾기'}</h2>
      <p>{en ? 'Browse community stories in the workshop. Search by title or creator and filter by difficulty or ratings. Story details show the information needed to choose what to play.' : '창작마당에서 다른 제작자의 작품을 둘러보세요. 제목과 제작자로 검색하고 난이도와 평점 등으로 작품을 찾을 수 있습니다. 작품 상세에서 플레이할 작품의 정보를 확인하세요.'}</p>
      <h2>{en ? 'Play' : '플레이'}</h2>
      <ol>
        <li>{en ? 'Sign in with a guest nickname or a configured Google account.' : '게스트 닉네임 또는 설정된 구글 계정으로 로그인하세요.'}</li>
        <li>{en ? 'Choose a story using Create room, or join a room with its code. Check the story’s supported player count before starting.' : '방 만들기에서 작품을 고르거나 방 코드로 참가하세요. 시작 전 작품의 지원 인원을 확인하세요.'}</li>
        <li>{en ? 'Solo investigations offer clues and story choices. In multiplayer stories, read your private role information, examine shared clues, discuss outside the app and vote.' : '1인 수사에서는 단서와 이야기의 선택지를 따라 진행하세요. 다인 작품에서는 각자의 비밀 역할 정보를 읽고 공통 단서를 확인하며, 앱 밖에서 토론한 뒤 투표하세요.'}</li>
      </ol>
      <h2>{en ? 'Public pages' : '공개 페이지'}</h2>
      <ul>
        <li><a href={`${prefix}/`}>{en ? 'Play' : '플레이'}</a></li>
        <li><a href={`${prefix}/workshop/`}>{en ? 'Workshop' : '창작마당'}</a></li>
        <li><a href={`${prefix}/terms/`}>{en ? 'Terms of service' : '이용약관'}</a></li>
        <li><a href={`${prefix}/privacy/`}>{en ? 'Privacy policy' : '개인정보 처리방침'}</a></li>
      </ul>
    </main>
  </body>
</html>
