---
import { consentCopy } from './copy';
const en = Astro.url.pathname === '/en' || Astro.url.pathname.startsWith('/en/');
const copy = consentCopy[en ? 'en' : 'ko'];
---
<aside class="collection-settings" aria-label={copy.settings}>
  <p data-collection-sync-status role="status" hidden></p>
  <button type="button" data-collection-retry hidden>{en ? 'Retry preferences' : '설정 다시 확인'}</button>
  <button type="button" data-collection-settings data-consent-copy="settings" aria-haspopup="dialog">{copy.settings}</button>
</aside>
<dialog id="collection-dialog" class="modal ui-modal collection-dialog" aria-labelledby="collection-title" aria-describedby="collection-intro">
  <div class="collection-body">
  <h2 id="collection-title" tabindex="-1" data-consent-copy="title">{copy.title}</h2>
  <p id="collection-intro" data-consent-copy="intro">{copy.intro}</p>
  <section aria-labelledby="collection-basic-title">
    <h3 id="collection-basic-title" data-consent-copy="basicTitle">{copy.basicTitle}</h3>
    <p data-collection-basic data-consent-copy="basic">{copy.basic}</p>
  </section>
  <section aria-labelledby="collection-full-title">
    <h3 id="collection-full-title" data-consent-copy="fullTitle">{copy.fullTitle}</h3>
    <p data-collection-full data-consent-copy="full">{copy.full}</p>
  </section>
  <p data-collection-retention data-consent-copy="retention">{copy.retention}</p>
  <a data-collection-privacy data-consent-copy="privacy" href={en ? '/en/privacy/' : '/privacy/'}>{copy.privacy}</a>
  <a data-collection-account href={en ? '/en/mypage/' : '/mypage/'}>{en ? 'Account settings, sign out or delete account' : '계정 관리·로그아웃·탈퇴'}</a>
  <p data-collection-current role="status"></p>
  <p data-collection-error role="alert" hidden></p>
  </div>
  <div class="collection-actions">
    <button type="button" data-collection-choice="none" data-consent-copy="noneButton">{copy.noneButton}</button>
    <button type="button" data-collection-choice="basic" data-consent-copy="basicButton">{copy.basicButton}</button>
    <button type="button" data-collection-choice="full" data-consent-copy="fullButton">{copy.fullButton}</button>
  </div>
</dialog>
<script>
  import { consentCopy } from './copy';
  import { collectionConsent, consentProblem, saveCollectionConsent, syncCollectionConsent, watchCollectionConsent } from './consent';
  import { initializeAnalytics, trackPageView } from '../../analytics.js';
  import type { ConsentScope } from '@festival/shared/consent';
  const dialog = document.querySelector<HTMLDialogElement>('#collection-dialog')!;
  const settings = document.querySelector<HTMLButtonElement>('[data-collection-settings]')!;
  const buttons = [...dialog.querySelectorAll<HTMLButtonElement>('[data-collection-choice]')];
  const error = dialog.querySelector<HTMLElement>('[data-collection-error]')!;
  let busy = false;
  let opener: HTMLElement | null = null;
  const isEnglish = () => location.pathname === '/en' || location.pathname.startsWith('/en/');
  const open = () => { if (!dialog.open) { opener = document.activeElement instanceof HTMLElement ? document.activeElement : null; dialog.showModal(); dialog.querySelector<HTMLElement>('#collection-title')!.focus(); } };
  const close = () => { dialog.close(); (opener?.isConnected && opener !== document.body ? opener : settings).focus(); };
  const update = (prompt = false) => {
    const copy = consentCopy[isEnglish() ? 'en' : 'ko'];
    for (const node of document.querySelectorAll<HTMLElement>('[data-consent-copy]')) node.textContent = copy[node.dataset.consentCopy as keyof typeof copy];
    settings.closest('aside')?.setAttribute('aria-label', copy.settings);
    dialog.querySelector<HTMLAnchorElement>('[data-collection-privacy]')!.href = isEnglish() ? '/en/privacy/' : '/privacy/';
    const accountLink = dialog.querySelector<HTMLAnchorElement>('[data-collection-account]')!;
    accountLink.href = isEnglish() ? '/en/mypage/' : '/mypage/'; accountLink.textContent = isEnglish() ? 'Account settings, sign out or delete account' : '계정 관리·로그아웃·탈퇴';
    const scope = collectionConsent()?.scope;
    const en = isEnglish();
    const names = en ? {none:'Not collected',basic:'Basic only',full:'Full collection'} : {none:'수집 안 함',basic:'기본 수집',full:'전체 수집'};
    dialog.querySelector<HTMLElement>('[data-collection-current]')!.textContent = scope ? `${en ? 'Current choice' : '현재 선택'}: ${names[scope]}` : '';
    initializeAnalytics();
    if (prompt && !scope) open();
  };
  const syncStatus = document.querySelector<HTMLElement>('[data-collection-sync-status]')!;
  const retry = document.querySelector<HTMLButtonElement>('[data-collection-retry]')!;
  const showProblem = () => {
    const message = isEnglish() ? 'Preferences could not be confirmed. Browser analytics are paused. Retry to confirm; a failed withdrawal has not yet been confirmed by the server.' : '설정을 확인하지 못해 브라우저 분석 전송을 일시 중단했습니다. 다시 확인해 주세요. 철회 저장 실패 시 서버의 동의 변경을 아직 확인하지 못한 상태입니다.';
    error.textContent = message; error.hidden = false;
    syncStatus.textContent = message; syncStatus.hidden = false; retry.hidden = false;
  };
  retry.onclick = () => { void syncCollectionConsent(true).catch(showProblem); };
  settings.onclick = open;
  window.addEventListener('consent:required', open);
  for (const button of buttons) button.onclick = async () => {
    if (busy) return; busy = true; error.hidden = true; buttons.forEach(b => b.disabled = true);
    try { await saveCollectionConsent(button.dataset.collectionChoice as ConsentScope); if (consentProblem()) { showProblem(); open(); } else close(); }
    catch { error.textContent = isEnglish() ? 'Your choice could not be saved. Allow site cookies and retry. If withdrawing, close all site tabs until it is saved; previously loaded external tags may still run.' : '선택을 저장할 수 없습니다. 사이트 쿠키를 허용하고 다시 시도해 주세요. 철회 중이라면 저장될 때까지 모든 사이트 탭을 닫아 주세요. 이미 실행된 외부 태그는 계속 실행될 수 있습니다.'; error.hidden = false; }
    finally { busy = false; buttons.forEach(b => b.disabled = false); }
  };
  dialog.addEventListener('cancel', event => { event.preventDefault(); if (!busy) close(); });
  dialog.addEventListener('keydown', event => {
    if (event.key !== 'Tab') return;
    const focusable = [...dialog.querySelectorAll<HTMLElement>('a[href],button:not(:disabled)')];
    const first = focusable[0], last = focusable.at(-1);
    if (event.shiftKey && (document.activeElement === first || document.activeElement?.id === 'collection-title')) { event.preventDefault(); last?.focus(); }
    else if (!event.shiftKey && document.activeElement === last) { event.preventDefault(); first?.focus(); }
  });
  window.addEventListener('consent:changed', event => {
    const detail = (event as CustomEvent).detail;
    if (detail?.pending) return;
    if (detail?.error) { showProblem(); if (!collectionConsent() || consentProblem() === 'unsaved-restriction') open(); return; }
    syncStatus.hidden = true; retry.hidden = true; error.hidden = true; update(true);
  });
  window.addEventListener('site:navigation', () => { update(); trackPageView(isEnglish() ? 'en' : 'ko'); });
  watchCollectionConsent();
  void syncCollectionConsent().catch(() => { error.textContent = isEnglish() ? 'Could not load your preferences. Data collection is paused. Please try again.' : '설정을 불러오지 못해 데이터 수집을 중단했습니다. 다시 시도해 주세요.'; error.hidden = false; open(); });
</script>
<style>
  .collection-settings{padding:var(--spacing-4);border-top:var(--border-thin) solid var(--color-festival-line)}
  .collection-dialog{width:min(44rem,calc(100% - var(--spacing-6)));padding:var(--spacing-6);overflow:hidden}
  .collection-dialog[open]{display:flex;flex-direction:column}
  .collection-body{overflow:auto;min-height:0;overscroll-behavior:contain}
  .collection-dialog::backdrop{background:var(--color-festival-modal-backdrop)}
  h2{font-size:var(--typography-size-control-6);line-height:1.4;margin-bottom:var(--spacing-4)}
  h3{font-size:1.1rem;line-height:1.5;margin:0 0 var(--spacing-2)}
  p{line-height:1.7;margin:var(--spacing-3) 0}
  section{padding:var(--spacing-4);margin:var(--spacing-4) 0;border:var(--border-thin) solid var(--color-festival-line)}
  .collection-body>a{display:inline-flex;align-items:center;min-height:44px;margin-right:var(--spacing-3);max-width:100%}
  .collection-actions{flex-shrink:0;display:flex;flex-wrap:wrap;gap:var(--spacing-3);margin-top:var(--spacing-4)}
  button{font:inherit;min-height:44px;padding:var(--spacing-3) var(--spacing-4);border:var(--border-thin) solid var(--color-festival-line);background:var(--color-festival-panel);color:var(--color-festival-text);cursor:pointer}
  button:disabled{opacity:.6;cursor:wait}
  [data-collection-choice="full"]{background:var(--color-festival-gold);color:var(--color-festival-bg)}
  [hidden]{display:none}
  @media(max-width:480px){.collection-dialog{padding:var(--spacing-4)}.collection-actions{flex-direction:column}.collection-actions button{width:100%}}
</style>
