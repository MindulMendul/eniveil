    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>404 · Story Archive</title>
  </head>
  <body class="m-0 min-h-screen bg-festival-bg font-sans text-festival-text">
    <div class="shell">
      <PageState kind="error" message="404 · 페이지를 찾을 수 없습니다 / Page not found">
        <CallToAction href="/">홈으로 / Home →</CallToAction>
      </PageState>
    </div>
  </body>
</html>
